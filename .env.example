# MedSync Environment Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & ABDM Edge Salt
ABDM_SALT=medsync-sih-2026-edge-node-salt-secret
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Database
SQLITE_DB_PATH=medsync_edge.db

# Central Index (Turso / Mock)
TURSO_URL=
TURSO_AUTH_TOKEN=
MOCK_TURSO=true

# Cloud LLM Configuration (OpenAI, Gemini, or Claude)
LLM_PROVIDER=gemini # gemini, openai, or anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
